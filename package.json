{
  "name": "dori-top-fullstack",
  "version": "2.0.0",
  "description": "DORI TOP — O'zbekiston bo'ylab dorilarni qidirish va narxlarni taqqoslash platformasi (Node.js 22.13+/24 built-in node:sqlite, nol C++ qaramlik)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run build:vendor && npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/assets/app.css --minify",
    "build:vendor": "node scripts/copy-vendor.js",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/assets/app.css --watch",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "admin:create": "node scripts/create-admin.js",
    "seed:catalog": "node scripts/seed-catalog.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide": "^0.460.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}